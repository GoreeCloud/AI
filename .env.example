PORT=8787
OLLAMA_URL=http://127.0.0.1:11434
GOREECLOUD_AI_DATA_DIR=./data
# Optional for direct API clients. Same-origin browser auth will later move to GoreeCloud Identity sessions.
# GOREECLOUD_AI_API_TOKEN=replace-me
MAX_BODY_BYTES=1000000
MAX_FILE_BYTES=26214400
# Development attachment-library safety limits. These do not replace production per-user/Workspace quota policy.
MAX_FILE_COUNT=1000
MAX_TOTAL_FILE_BYTES=1073741824
# Maximum bytes accepted by the passive UTF-8 text/Markdown/JSON extraction boundary after Wardveil release.
MAX_TEXT_EXTRACTION_BYTES=2097152
REQUEST_TIMEOUT_MS=120000
