# Do not commit your filled .env file.
GOREECLOUD_AI_TOKEN=GENERATE_A_LONG_RANDOM_TOKEN
OPENROUTER_API_KEY=
# OLLAMA_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Conservative daily external call count; not a dollar spending cap.
GOREECLOUD_AI_DAILY_CLOUD_REQUEST_LIMIT=20
# Development-only Vite origin:
GOREECLOUD_AI_CORS_ORIGINS=http://127.0.0.1:5173
GOREECLOUD_AI_DB_PATH=./data/ai.sqlite3
# Optional manually-authorized MCP endpoint (HTTPS, or localhost HTTP)
# GOREECLOUD_AI_MCP_URL=https://your-trusted-mcp-server.example/mcp
# GOREECLOUD_AI_MCP_TOKEN=
# GOREECLOUD_AI_MCP_ALLOWED_TOOLS=read_document,search

# Auth modes: owner (default), oidc (strict pinned RS256 JWKS, no token fallback).
GOREECLOUD_AI_AUTH_MODE=owner
# GOREECLOUD_AI_OIDC_ISSUER=https://identity.example.invalid/realms/goree
# GOREECLOUD_AI_OIDC_AUDIENCE=goreecloud-ai
# GOREECLOUD_AI_OIDC_OWNER_SUB=owner-subject-from-issuer
# GOREECLOUD_AI_OIDC_JWKS_PATH=/private/config/verified-public-jwks.json
# GOREECLOUD_AI_OIDC_REQUIRED_SCOPE=goreecloud.ai.owner
# Require the OpenRouter key's provider-owned capped credits before cloud usage.
GOREECLOUD_AI_REQUIRE_CAPPED_OPENROUTER_KEY=false
# No automatic deletion. Explicit owner-approved retention cleanup when >0.
GOREECLOUD_AI_CONVERSATION_RETENTION_DAYS=0
# Offline encryption key must never be committed, logged or pasted into commands.
# GOREECLOUD_AI_BACKUP_KEY=PRIVATE_32_BYTE_BASE64_KEY_FROM_SECRET_MANAGER
